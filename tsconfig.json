{
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"types": ["unplugin-icons/types/svelte"],
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true
	}
}
